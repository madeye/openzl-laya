# Generated by scripts/laya/update_homebrew_formula.sh from
# https://github.com/madeye/openzl-laya/blob/dev/packaging/laya/openzl-laya.rb.in
class OpenzlLaya < Formula
  desc "OpenZL CLI with local Laya integer routing on Core ML"
  homepage "https://github.com/madeye/openzl-laya"
  url "https://github.com/madeye/openzl-laya/releases/download/v@VERSION@/openzl-laya-@VERSION@-macos-arm64.tar.gz"
  version "@VERSION@"
  sha256 "@SHA256@"
  license "BSD-3-Clause"

  depends_on arch: :arm64
  depends_on macos: :sonoma

  def install
    # zli starts the worker from its own directory, so keep them together.
    bin.install "bin/zli", "bin/openzl-laya-worker"
  end

  def caveats
    <<~EOS
      Download the Laya model once (about 940 MB, SHA-256 verified):
        openzl-laya-worker prepare
      Without it, `zli compress --laya` measures candidates locally instead.
    EOS
  end

  test do
    assert_match "Version", shell_output("#{bin}/zli --version")
    assert_match "Usage: openzl-laya-worker", shell_output(bin/"openzl-laya-worker")
    (testpath/"in.bin").binwrite([1, 2, 3, 4].pack("Q<*") * 65_536)
    system bin/"zli", "compress", "in.bin", "--profile", "le-u64", "-o", "out.zl"
    system bin/"zli", "decompress", "out.zl", "-o", "round.bin"
    assert_equal (testpath/"in.bin").binread, (testpath/"round.bin").binread
  end
end
