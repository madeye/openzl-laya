class WorkerError(Exception):
    pass


# ---------------------------------------------------------------- interpreter


def interpreter():
    """The Python that carries the inference dependencies, if it is not this one."""
    override = os.environ.get("OPENZL_LAYA_PYTHON")
    if override:
        return override
    candidate = VENV / "bin" / "python"
    return str(candidate) if candidate.exists() else None


def has_dependencies():
    try:
        import safetensors  # noqa: F401
        import tokenizers  # noqa: F401
        import torch  # noqa: F401
        import transformers  # noqa: F401
    except ImportError:
        return False
    return True


def reexec_if_needed(argv):
    """Serve and start run under the private environment; prepare may create it."""
    target = interpreter()
    if target is None or os.environ.get("OPENZL_LAYA_REEXEC"):
        return
    if Path(target).resolve() == Path(sys.executable).resolve():
        return
    os.environ["OPENZL_LAYA_REEXEC"] = "1"
    os.execv(target, [target, str(SCRIPT), *argv])


def dependencies_available(python):
    if Path(python).resolve() == Path(sys.executable).resolve():
        return has_dependencies()
    check = subprocess.run(
        [python, str(SCRIPT), "check-dependencies"],
        env={**os.environ, "OPENZL_LAYA_REEXEC": "1"},
    )
    return check.returncode == 0


def ensure_environment():
    python = interpreter() or sys.executable
    if dependencies_available(python):
        print(f"Dependencies available: {python}")
        return
    if os.environ.get("OPENZL_LAYA_PYTHON"):
        raise WorkerError(
            "OPENZL_LAYA_PYTHON lacks torch/transformers/safetensors/tokenizers"
        )
    VENV.parent.mkdir(parents=True, exist_ok=True)
    python = VENV / "bin" / "python"
    uv = shutil.which("uv")
    print(f"Creating private environment: {VENV}")
    if uv:
        subprocess.run([uv, "venv", "--seed", str(VENV)], check=True)
        pip = [uv, "pip", "install", "--python", str(python)]
    else:
        subprocess.run([sys.executable, "-m", "venv", str(VENV)], check=True)
        pip = [str(python), "-m", "pip", "install"]
    subprocess.run([*pip, "--index-url", TORCH_INDEX, *REQUIREMENTS], check=True)
    subprocess.run([*pip, *EXTRA_REQUIREMENTS], check=True)
    if not dependencies_available(str(python)):
        raise WorkerError("private environment lacks the inference dependencies")


# --------------------------------------------------------------------- assets


def digest(path):
    hasher = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            hasher.update(block)
    return hasher.hexdigest()


def verify_assets():
    for relative, expected in ARTIFACTS:
        path = CACHE / relative
        try:
            actual = digest(path)
        except OSError:
            actual = None
        if actual != expected:
            raise WorkerError(
                f"Missing/corrupt {relative}; run openzl-laya-worker prepare"
            )


def prepare():
    ensure_environment()
    CACHE_ROOT.mkdir(parents=True, exist_ok=True)
    with ProcessLock(CACHE_ROOT / "prepare.lock", wait=True):
        try:
            verify_assets()
        except WorkerError:
            pass
        else:
            (CACHE / "sha256.json").write_text(
                json.dumps(dict(ARTIFACTS), indent=2) + "\n"
            )
            print(f"Assets verified: {CACHE}")
            return
        curl = shutil.which("curl")
        if not curl:
            raise WorkerError("curl is required to download assets")
        staging = CACHE_ROOT / f".prepare-{uuid.uuid4()}"
        staging.mkdir()
        try:
            for relative, expected in ARTIFACTS:
                print(f"Downloading {relative}")
                destination = staging / relative
                destination.parent.mkdir(parents=True, exist_ok=True)
                # curl honors HTTPS_PROXY/ALL_PROXY/NO_PROXY; arguments never pass
                # through a shell.
                result = subprocess.run(
                    [
                        curl,
                        "--fail",
                        "--location",
                        "--silent",
                        "--show-error",
                        "--proto",
                        "=https",
                        "--proto-redir",
                        "=https",
                        "--connect-timeout",
                        "30",
                        "--max-time",
                        "1800",
                        "--retry",
                        "2",
                        "--output",
                        str(destination),
                        f"https://huggingface.co/{MODEL_REPO}/resolve/{MODEL_REVISION}/{relative}",
                    ]
                )
                if result.returncode != 0 or digest(destination) != expected:
                    raise WorkerError(
                        f"Artifact download/hash check failed: {relative}"
                    )
            (staging / "sha256.json").write_text(
                json.dumps(dict(ARTIFACTS), indent=2) + "\n"
            )
            if CACHE.exists():
                shutil.rmtree(CACHE)
            staging.rename(CACHE)
        finally:
            shutil.rmtree(staging, ignore_errors=True)
        print(f"Prepared pinned {MODEL_REPO}@{MODEL_REVISION[:12]} assets: {CACHE}")
    precompile()


def precompile():
    """Populate the compiled-kernel cache so that later cold starts are fast."""
    python = interpreter() or sys.executable
    print("Compiling kernels (cached for later starts)", flush=True)
    subprocess.run(
        [python, str(SCRIPT), "warmup"],
        check=True,
        env={**os.environ, "OPENZL_LAYA_REEXEC": "1"},
    )


# ------------------------------------------------------------------- runtime


class ProcessLock:
    """Advisory exclusive lock on an owner-checked regular file."""

    def __init__(self, path, wait=False):
        self.fd = os.open(
            path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600
        )
        try:
            info = os.fstat(self.fd)
            if info.st_uid != os.getuid() or not stat.S_ISREG(info.st_mode):
                raise WorkerError("unsafe lock file")
            fcntl.flock(self.fd, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except (OSError, WorkerError):
            os.close(self.fd)
            self.fd = -1
            raise WorkerError("worker/prepare already running or unsafe lock")

    def close(self):
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()


def ensure_runtime():
    try:
        os.mkdir(RUNTIME, 0o700)
    except FileExistsError:
        pass
    info = os.lstat(RUNTIME)
    if (
        info.st_uid != os.getuid()
        or not stat.S_ISDIR(info.st_mode)
        or stat.S_IMODE(info.st_mode) != 0o700
    ):
        raise WorkerError("unsafe runtime directory")


def resident_bytes():
    try:
        with open("/proc/self/statm") as handle:
            return int(handle.read().split()[1]) * os.sysconf("SC_PAGE_SIZE")
    except (OSError, ValueError, IndexError):
        return 0


def read_exactly(connection, count, deadline):
    data = bytearray()
    while len(data) < count:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise WorkerError("message read deadline exceeded")
        ready, _, _ = select.select([connection], [], [], min(2.0, remaining))
        if not ready:
            raise WorkerError("message read deadline exceeded")
        chunk = connection.recv(count - len(data))
        if not chunk:
            raise WorkerError("client disconnected or timed out")
        data.extend(chunk)
    return bytes(data)


def receive(connection):
    deadline = time.monotonic() + MESSAGE_DEADLINE_S
    (size,) = struct.unpack("!I", read_exactly(connection, 4, deadline))
    if size == 0 or size > MAXIMUM_MESSAGE:
        raise WorkerError("invalid message size")
    return read_exactly(connection, size, deadline)


def send_message(connection, payload):
    data = json.dumps(payload).encode()
    if len(data) > MAXIMUM_MESSAGE:
        raise WorkerError("message too large")
    connection.sendall(struct.pack("!I", len(data)) + data)


def base_response(request_id):
    return {
        "version": 1,
        "id": request_id,
        "revision": MODEL_REVISION,
        "pid": os.getpid(),
        "resident_bytes": resident_bytes(),
    }


def validate_request(request):
    if not isinstance(request, dict):
        raise WorkerError("invalid request")
    request_id = request.get("id")
    if (
        request.get("version") != 1
        or not isinstance(request_id, str)
        or not request_id
        or len(request_id.encode()) > 128
        or request.get("command") not in ("status", "stop", "decide")
    ):
        raise WorkerError("invalid request")
    if request["command"] == "decide":
        statistics = request.get("statistics")
        context = request.get("context") or ""
        deadline = request.get("deadline_ms")
        now = time.time() * 1000
        if (
            request.get("candidates") != CANDIDATES
            or not isinstance(statistics, dict)
            or not statistics
            or not isinstance(context, str)
            or len(context.encode()) > 4096
            or not isinstance(deadline, (int, float))
            or isinstance(deadline, bool)
            or not math.isfinite(deadline)
            or deadline <= now
            or deadline > now + 61000
        ):
            raise WorkerError("invalid or expired decision request")
        for value in statistics.values():
            if isinstance(value, bool):
                continue
            if not isinstance(value, (int, float)) or not math.isfinite(value):
                raise WorkerError("nonfinite statistic")


def control(command):
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(MESSAGE_DEADLINE_S)
        try:
            connection.connect(str(SOCKET_PATH))
        except OSError:
            raise WorkerError("worker not running")
        request_id = str(uuid.uuid4())
        send_message(connection, {"version": 1, "id": request_id, "command": command})
        response = json.loads(receive(connection))
    if (
        response.get("id") != request_id
        or response.get("version") != 1
        or response.get("revision") != MODEL_REVISION
    ):
        raise WorkerError("bad control response")
    return response


# ------------------------------------------------------------------ inference


class Inference:
    """One loaded checkpoint answering the fixed seven-way choice question."""

    def __init__(self):
        import torch
        from safetensors.torch import load_file
        from tokenizers import Tokenizer
        from transformers import AutoConfig, AutoModel
        from transformers.initialization import no_init_weights

        self.torch = torch
        self.config = json.loads((CACHE / "rl_agent_config.json").read_text())
        self.max_len = int(self.config.get("max_len", 1024))
        self.head_max_len = int(self.config.get("head_max_len", 256))
        self.temperature = [
            float(t) for t in self.config.get("temperature", [1.0, 1.0, 1.0])
        ]
        self.temperature_by_options = {
            k: float(v)
            for k, v in self.config.get("temperature_by_options", {}).items()
        }
        self.tokenizer = Tokenizer.from_file(
            str(CACHE / "tokenizer" / "tokenizer.json")
        )
        self.cls_id = self.tokenizer.token_to_id("<bos>")
        self.sep_id = self.tokenizer.token_to_id("<eos>")
        self.mask_id = self.tokenizer.token_to_id("<mask>")
        self.pad_id = self.tokenizer.token_to_id("<pad>")
        if None in (self.cls_id, self.sep_id, self.mask_id, self.pad_id):
            raise WorkerError("tokenizer lacks the expected special tokens")
        started = time.perf_counter()
        self.device = select_device(torch)
        elapsed = (time.perf_counter() - started) * 1000
        print(f"device {self.device} selected in {elapsed:.0f} ms", flush=True)
        if self.device.type == "cuda":
            self.dtype = (
                torch.bfloat16
                if self.config.get("amp_dtype", "fp16") == "bf16"
                else torch.float16
            )
            if torch.cuda.get_device_capability(self.device)[0] < 8:
                self.dtype = torch.float16
            self.compute_units = "cuda:" + torch.cuda.get_device_name(self.device)
        else:
            self.dtype = torch.float32
            self.compute_units = "cpu"
        encoder_config = AutoConfig.from_pretrained(str(CACHE / "encoder"))
        # Random initialization of the 307M-parameter encoder takes minutes on
        # the CPU; the checkpoint overwrites every parameter anyway.
        with no_init_weights(), torch.device(self.device):
            encoder = AutoModel.from_config(encoder_config, attn_implementation="sdpa")
            self.model = DecisionModel(
                encoder,
                int(self.config.get("head_layers", 2)),
                len(self.config.get("act_costs", {})) + 1,
            )
        weights = load_file(str(CACHE / "model.safetensors"), device=str(self.device))
        self.model.load_state_dict(weights, strict=True)
        self.model.to(self.device).eval()
        self.compiled = False
        if self.device.type == "cuda":
            # Autocast would otherwise re-cast every fp32 Linear weight to
            # bfloat16 on each call, which dominated GPU time. Storing them in
            # bfloat16 gives the same rounded values with no per-call copies;
            # LayerNorm, embeddings and the residual stream stay fp32.
            for module in self.model.modules():
                if isinstance(module, torch.nn.Linear):
                    module.to(self.dtype)
            self.forward = self.model
            if COMPILE:
                try:
                    # Inductor fuses elementwise kernels and replays one CUDA
                    # graph per padded length, removing ~2000 launches per
                    # answer. dynamic=True compiles once for every bucket.
                    self.forward = torch.compile(
                        self.model, mode="reduce-overhead", dynamic=True
                    )
                    self.compiled = True
                except Exception as error:  # noqa: BLE001 - keep eager on any failure
                    print(f"torch.compile unavailable ({error}); eager", flush=True)
        else:
            self.forward = self.model
        self.head, self.markers = self.build_head()
        if len(self.markers) != len(DESCRIPTIONS):
            raise WorkerError("choice question exceeds prompt head budget")

    def encode(self, text):
        return self.tokenizer.encode(text, add_special_tokens=False).ids

    def build_head(self):
        """Port of laya `build_sequence` / FluidUse LayaSequenceBuilder.parts."""
        mask_token = "<mask>"
        head_ids = self.encode(
            f"choice question: {INSTRUCTIONS.replace(mask_token, ' ')}"
        )
        option_ids = [
            [self.mask_id] + self.encode(" " + option.replace(mask_token, " "))[:48]
            for option in DESCRIPTIONS
        ]
        option_budget = self.head_max_len - sum(len(o) for o in option_ids)
        if option_budget < 16:
            per_option = max(4, (self.head_max_len - 16) // max(1, len(option_ids)))
            option_ids = [o[:per_option] for o in option_ids]
            option_budget = self.head_max_len - sum(len(o) for o in option_ids)
        head_ids = head_ids[: max(8, option_budget)]
        ids = [self.cls_id] + head_ids + [self.sep_id]
        markers = []
        for option in option_ids:
            markers.append(len(ids))
            ids.extend(option)
        ids.append(self.sep_id)
        return ids, markers

    def sequence(self, state):
        state_ids = self.encode(state.replace("<mask>", " "))
        room = max(0, self.max_len - len(self.head) - 1)
        kept = state_ids[:room]
        ids = (self.head + kept + [self.sep_id])[: self.max_len]
        markers = [m for m in self.markers if m < self.max_len]
        if len(markers) != len(DESCRIPTIONS):
            raise WorkerError("prompt head does not fit the model context")
        return ids, markers, len(kept) < len(state_ids)

    def padded_length(self, tokens):
        if self.device.type != "cuda" or PAD_BUCKET <= 1:
            return tokens
        return min(self.max_len, -(-tokens // PAD_BUCKET) * PAD_BUCKET)

    def answer(self, state):
        torch = self.torch
        ids, markers, truncated = self.sequence(state)
        count = len(markers)
        length = self.padded_length(len(ids))
        input_ids = torch.full(
            (1, length), self.pad_id, dtype=torch.long, device=self.device
        )
        input_ids[0, : len(ids)] = torch.tensor(
            ids, dtype=torch.long, device=self.device
        )
        attention = torch.zeros((1, length), dtype=torch.long, device=self.device)
        attention[0, : len(ids)] = 1
        marker_pos = torch.tensor([markers], dtype=torch.long, device=self.device)
        marker_mask = torch.ones((1, count), dtype=torch.bool, device=self.device)
        qtype = torch.zeros(1, dtype=torch.long, device=self.device)
        with (
            torch.no_grad(),
            torch.autocast(
                device_type=self.device.type,
                dtype=self.dtype,
                enabled=self.device.type == "cuda",
            ),
        ):
            try:
                logits, act = self.forward(
                    input_ids, attention, marker_pos, marker_mask, qtype
                )
            except Exception as error:  # noqa: BLE001 - compiled path is optional
                if not self.compiled:
                    raise
                print(f"compiled forward failed ({error}); eager", flush=True)
                self.forward, self.compiled = self.model, False
                logits, act = self.forward(
                    input_ids, attention, marker_pos, marker_mask, qtype
                )
        logits = logits.float().cpu()[0, :count].tolist()
        act = torch.softmax(act.float(), -1).cpu()[0].tolist()
        size = (
            "2"
            if count <= 2
            else "3-5"
            if count <= 5
            else "6-10"
            if count <= 10
            else "11+"
        )
        scale = self.temperature_by_options.get(f"choice:{size}", self.temperature[0])
        scaled = [z / max(1e-3, scale) for z in logits]
        peak = max(scaled)
        exponentials = [math.exp(z - peak) for z in scaled]
        total = sum(exponentials)
        probabilities = [e / total for e in exponentials]
        if not all(math.isfinite(p) for p in probabilities) or not all(
            math.isfinite(a) for a in act
        ):
            raise WorkerError("model returned non-finite values")
        entropy = -sum(p * math.log(max(p, 1e-12)) for p in probabilities)
        confidence = (
            1.0 if count < 2 else min(1.0, max(0.0, 1 - entropy / math.log(count)))
        )
        return {
            "probabilities": probabilities,
            "confidence": confidence,
            "action_probability": act[0],
            "truncated": truncated,
            "token_count": len(ids),
            "padded_tokens": length,
        }

    def decide(self, request, arrival_ms):
        response = base_response(request.get("id"))
        try:
            validate_request(request)
            now = time.time() * 1000
            if now >= request["deadline_ms"]:
                raise WorkerError("queue deadline exceeded")
            state = json.dumps(
                request["statistics"],
                sort_keys=True,
                separators=(",", ":"),
                ensure_ascii=False,
            )
            state += "\nContext: " + (request.get("context") or "")
            start = time.perf_counter()
            answer = self.answer(state)
            if self.device.type == "cuda":
                self.torch.cuda.synchronize()
            response["inference_ms"] = (time.perf_counter() - start) * 1000
            response["queue_ms"] = now - arrival_ms
            best = max(
                range(len(answer["probabilities"])),
                key=lambda i: answer["probabilities"][i],
            )
            response["selected"] = CANDIDATES[best]
            response["candidates"] = CANDIDATES
            response.update(answer)
        except Exception as error:  # noqa: BLE001 - every failure is reported to the client
            response["error"] = str(error)
        response["compute_units"] = self.compute_units
        response["precision"] = str(self.dtype).replace("torch.", "")
        response["bucket"] = self.max_len
        response["compiled"] = self.compiled
        return response


def warmup(inference):
    """Statistics prompts span roughly 300-450 tokens; cover those buckets."""
    if inference.device.type != "cuda":
        inference.answer("{}")
        return
    lengths = sorted({inference.padded_length(n) for n in (200, 320, 384, 448, 512)})
    for length in lengths:
        target = min(length, inference.max_len) - 1
        state = " ".join(["a"] * max(1, target - len(inference.head) - 1))
        while len(inference.sequence(state)[0]) < target:
            state += " a"
        while len(inference.sequence(state)[0]) > length:
            state = state[:-2]
        for _ in range(3):
            inference.answer(state)


def meminfo():
    values = {}
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            key, _, rest = line.partition(":")
            values[key] = int(rest.split()[0]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    return values


def reclaim_page_cache():
    """Free page cache before CUDA initialization on unified-memory systems.

    The CUDA driver needs genuinely free memory to create a context and does
    not wait for the kernel to evict reclaimable cache, so a large file cache
    (for example after a build) makes context creation fail with
    CUDA_ERROR_OUT_OF_MEMORY. Touching and releasing an anonymous buffer forces
    the eviction without privileges. The buffer never exceeds the cache plus
    free memory minus a 4 GiB margin, so it cannot starve other processes.
    Returns the bytes touched.
    """
    info = meminfo()
    free, available = info.get("MemFree", 0), info.get("MemAvailable", 0)
    cache = max(0, available - free)
    size = int(min(free + cache - (4 << 30), 16 << 30))
    if cache < (1 << 30) or size <= 0:
        return 0
    import numpy

    buffer = numpy.empty(size, dtype=numpy.uint8)
    step = 1 << 28
    for offset in range(0, size, step):
        buffer[offset : offset + step] = 1
    del buffer
    return size


def select_device(torch):
    requested = os.environ.get("OPENZL_LAYA_DEVICE", "cuda")
    if requested == "cpu" or not torch.cuda.is_available():
        return torch.device("cpu")
    error = None
    # A worker that just exited may still be releasing its context, and the
    # page cache may hold the free memory; try, wait, reclaim, wait again.
    for attempt in range(4):
        try:
            torch.zeros(1, device=requested)
            return torch.device(requested)
        except Exception as failure:  # noqa: BLE001 - driver errors vary
            error = failure
        if attempt == 1:
            reclaimed = reclaim_page_cache()
            if reclaimed:
                print(
                    f"reclaimed {reclaimed >> 20} MiB of page cache before CUDA "
                    "initialization",
                    flush=True,
                )
        else:
            time.sleep(1.0)
    if os.environ.get("OPENZL_LAYA_DEVICE"):
        raise WorkerError(f"cannot use {requested}: {error}")
    print(f"CUDA unavailable ({str(error).splitlines()[0]}); using CPU", flush=True)
    return torch.device("cpu")


def build_decision_model():
    """The upstream laya DecisionModel (Apache-2.0), ported verbatim in structure."""
    import torch
    import torch.nn as nn

    class DecisionModel(nn.Module):
        def __init__(self, encoder, head_layers=2, n_act=2, dropout=0.1):
            super().__init__()
            self.encoder = encoder
            d = encoder.config.hidden_size
            nhead = max(1, d // 64)
            layer = nn.TransformerEncoderLayer(
                d, nhead, 4 * d, dropout, batch_first=True, norm_first=True
            )
            self.head = (
                nn.TransformerEncoder(layer, head_layers, enable_nested_tensor=False)
                if head_layers > 0
                else None
            )
            self.type_emb = nn.Embedding(3, d)
            self.scorer = nn.Sequential(
                nn.LayerNorm(d), nn.Linear(d, d), nn.GELU(), nn.Linear(d, 1)
            )
            self.act_head = nn.Sequential(
                nn.Linear(d + 4, 256), nn.GELU(), nn.Linear(256, n_act)
            )
            self.register_buffer("temperature", torch.ones(3))

        def forward(self, input_ids, attention_mask, marker_pos, marker_mask, qtype):
            h = self.encoder(
                input_ids=input_ids, attention_mask=attention_mask
            ).last_hidden_state
            h = h + self.type_emb(qtype)[:, None, :]
            if self.head is not None:
                pad = ~attention_mask.bool()
                for layer in self.head.layers:
                    h = layer(h, src_key_padding_mask=pad)
            idx = marker_pos.clamp(min=0)[:, :, None].expand(-1, -1, h.size(-1))
            m = torch.gather(h, 1, idx)
            # Heads run in their own weight dtype; under upstream's autocast
            # that is bf16 as well, and this is a no-op for fp32 heads.
            m = m.to(self.scorer[1].weight.dtype)
            logits = self.scorer(m).squeeze(-1).float()
            logits = logits.masked_fill(~marker_mask, -1e4)
            p = torch.softmax(logits.detach(), -1)
            k = marker_mask.sum(-1).clamp(min=2).float()
            ent = -(p * torch.log(p.clamp_min(1e-9))).sum(-1) / torch.log(k)
            top2 = p.topk(2, -1).values
            feats = torch.stack(
                [top2[:, 0], top2[:, 0] - top2[:, 1], ent, k / 255.0], -1
            )
            pooled = h[:, 0].float()
            act_input = torch.cat([pooled, feats], -1)
            act_logits = self.act_head(act_input.to(self.act_head[0].weight.dtype))
            return logits, act_logits

    return DecisionModel


DecisionModel = None


