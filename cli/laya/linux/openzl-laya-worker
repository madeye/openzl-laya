class ServerState:
    def __init__(self):
        self.lock = threading.Lock()
        self.active = 0
        self.last = time.monotonic()
        self.stopping = False

    def enter(self):
        with self.lock:
            if self.active >= MAXIMUM_CONNECTIONS or self.stopping:
                return False
            self.active += 1
            self.last = time.monotonic()
            return True

    def leave(self):
        with self.lock:
            self.active -= 1
            self.last = time.monotonic()

    def stop(self):
        with self.lock:
            self.stopping = True

    def should_stop(self):
        with self.lock:
            return self.active == 0 and (
                self.stopping or time.monotonic() - self.last >= IDLE_EXIT_S
            )


def serve():
    global DecisionModel
    ensure_runtime()
    lock = ProcessLock(LOCK_PATH)
    try:
        # Only the lock owner removes stale sockets; never unlink another
        # worker's socket.
        try:
            info = os.lstat(SOCKET_PATH)
        except FileNotFoundError:
            info = None
        if info is not None:
            if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
                raise WorkerError("refusing to remove non-socket runtime entry")
            os.unlink(SOCKET_PATH)
        verify_assets()
        if not has_dependencies():
            raise WorkerError(
                "inference dependencies missing; run openzl-laya-worker prepare"
            )
        DecisionModel = build_decision_model()
        started = time.perf_counter()
        inference = Inference()
        print(
            f"model ready after {(time.perf_counter() - started) * 1000:.0f} ms",
            flush=True,
        )
        # Compile, autotune and record the CUDA graphs of the usual prompt
        # lengths within the startup allowance, before readiness.
        warmup(inference)
        print(
            f"loaded {MODEL_REPO}@{MODEL_REVISION[:12]} on "
            f"{inference.compute_units} ({inference.dtype}) in "
            f"{(time.perf_counter() - started) * 1000:.0f} ms",
            flush=True,
        )
        listener = socket.socket(socket.AF_UNIX)
        try:
            listener.bind(str(SOCKET_PATH))
            listener.listen(16)
            os.chmod(SOCKET_PATH, 0o600)
            listener.settimeout(0.25)
            state = ServerState()
            # One FIFO inference consumer on this thread: torch.compile's CUDA
            # graph trees are thread-local, so the thread that warmed up must
            # be the thread that answers. Connection threads only do I/O.
            jobs = queue.Queue()

            def finish(connection):
                connection.close()
                state.leave()

            def handle(connection, arrival_ms):
                try:
                    request = json.loads(receive(connection))
                    validate_request(request)
                except Exception:  # noqa: BLE001 - malformed or abandoned connection
                    finish(connection)
                    return
                if request["command"] != "decide":
                    try:
                        send_message(connection, base_response(request["id"]))
                    except OSError:
                        pass
                    if request["command"] == "stop":
                        state.stop()
                    finish(connection)
                    return
                jobs.put((connection, request, arrival_ms))

            def accept_loop():
                while not state.should_stop():
                    try:
                        connection, _ = listener.accept()
                    except (socket.timeout, OSError):
                        continue
                    connection.settimeout(None)
                    if not state.enter():
                        # Close excess connections immediately; clients
                        # benchmark locally.
                        connection.close()
                        continue
                    arrival_ms = time.time() * 1000
                    threading.Thread(
                        target=handle, args=(connection, arrival_ms), daemon=True
                    ).start()
                jobs.put(None)

            acceptor = threading.Thread(target=accept_loop, daemon=True)
            acceptor.start()
            while True:
                job = jobs.get()
                if job is None:
                    break
                connection, request, arrival_ms = job
                try:
                    send_message(connection, inference.decide(request, arrival_ms))
                except OSError:
                    pass
                finally:
                    finish(connection)
            acceptor.join()
        finally:
            listener.close()
            try:
                os.unlink(SOCKET_PATH)
            except OSError:
                pass
    finally:
        lock.close()


def start():
    try:
        status = control("status")
        print(f"running pid={status['pid']}")
        return
    except WorkerError:
        pass
    python = interpreter() or sys.executable
    fd = os.open(
        LOG_PATH, os.O_CREAT | os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW, 0o600
    )
    try:
        process = subprocess.Popen(
            [python, str(SCRIPT), "serve"],
            stdin=subprocess.DEVNULL,
            stdout=fd,
            stderr=fd,
            start_new_session=True,
            env={**os.environ, "OPENZL_LAYA_REEXEC": "1"},
        )
    finally:
        os.close(fd)
    started = time.monotonic()
    while time.monotonic() - started < 59:
        try:
            status = control("status")
            print(f"running pid={status['pid']}")
            return
        except WorkerError:
            pass
        # A competing starter may own the lock; wait for that worker too.
        if process.poll() is not None and process.returncode != 0:
            try:
                probe = ProcessLock(LOCK_PATH)
            except WorkerError:
                probe = None
            if probe is not None:
                probe.close()
                raise WorkerError(
                    "Worker startup failed; run openzl-laya-worker prepare; "
                    f"see {LOG_PATH}"
                )
        time.sleep(0.05)
    raise WorkerError(f"startup timed out; see {LOG_PATH}")


def stop():
    response = control("stop")
    print(json.dumps(response))
    started = time.monotonic()
    while time.monotonic() - started < 60:
        try:
            probe = ProcessLock(LOCK_PATH)
        except WorkerError:
            time.sleep(0.05)
            continue
        probe.close()
        return
    raise WorkerError("shutdown still draining work after 60 seconds")


def main(argv):
    global DecisionModel
    command = argv[0] if argv else "help"
    if command == "check-dependencies":
        sys.exit(0 if has_dependencies() else 1)
    ensure_runtime()
    if command in ("serve", "start", "warmup"):
        reexec_if_needed(argv)
    if command == "prepare":
        prepare()
    elif command == "serve":
        serve()
    elif command == "warmup":
        DecisionModel = build_decision_model()
        verify_assets()
        started = time.perf_counter()
        inference = Inference()
        warmup(inference)
        print(
            f"warm on {inference.compute_units}, compiled={inference.compiled}, "
            f"{(time.perf_counter() - started):.1f} s"
        )
    elif command == "start":
        start()
    elif command == "status":
        print(json.dumps(control("status")))
    elif command == "stop":
        stop()
    else:
        print("Usage: openzl-laya-worker prepare|start|status|stop")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except WorkerError as error:
        print(error, file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as error:
        print(f"command failed: {error}", file=sys.stderr)
        sys.exit(1)
